<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lobby – EchoChat</title>
    <meta name="description" content="EchoChat Lobby – Browse and join chat rooms in real time.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0B0F14;
            --surface: #111827;
            --border-subtle: #1F2937;
            --border-strong: #374151;
            --text-primary: #E5E7EB;
            --text-secondary: #9CA3AF;
            --text-muted: #6B7280;
            --accent: #3B82F6;
            --accent-hover: #2563EB;
            --shadow: 0 4px 12px rgba(0,0,0,0.5);
            --radius-card: 12px;
            --radius-input: 10px;
            --radius-btn: 8px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--surface);
            border-bottom: 1px solid var(--border-subtle);
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .navbar-brand img {
            width: 32px; height: 32px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid var(--border-subtle);
        }
        .navbar-brand-text {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
        }
        .navbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .user-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg);
            border: 1px solid var(--border-subtle);
            border-radius: 99px;
            padding: 6px 14px;
        }
        .user-avatar {
            width: 24px; height: 24px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            flex-shrink: 0;
        }
        .user-name { font-size: 0.85rem; font-weight: 500; color: var(--text-primary); }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 8px;
            background: transparent;
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            padding: 7px 14px;
            border-radius: var(--radius-btn);
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }
        .btn-logout:hover {
            border-color: #ef4444;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.05);
        }

        /* ===== HERO STRIP ===== */
        .hero-strip {
            background: var(--surface);
            border-bottom: 1px solid var(--border-subtle);
            padding: 32px 24px;
            display: flex;
            align-items: center;
            gap: 24px;
            position: relative;
        }
        .hero-strip h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
        }
        .hero-strip p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin-top: 6px;
        }
        .hero-stats {
            display: flex;
            gap: 32px;
            margin-top: 20px;
        }
        .stat {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .stat-val {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent);
        }
        .stat-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }

        /* ===== MAIN LAYOUT ===== */
        .main-layout {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px 24px 64px;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 32px;
        }
        @media (max-width: 900px) {
            .main-layout { grid-template-columns: 1fr; }
        }

        /* ===== SECTION HEADER ===== */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }
        .section-title {
            font-size: 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
        }
        .section-title i { color: var(--accent); font-size: 1.1rem; }

        /* Create Room Form */
        .create-room-form {
            display: flex;
            gap: 10px;
            flex: 1;
            max-width: 400px;
        }
        .create-room-form input {
            flex: 1;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-input);
            padding: 10px 16px;
            color: var(--text-primary);
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .create-room-form input::placeholder { color: var(--text-muted); }
        .create-room-form input:focus {
            border-color: var(--accent);
        }
        .btn-create {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--accent);
            border: none;
            border-radius: var(--radius-btn);
            padding: 10px 18px;
            color: #fff;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            white-space: nowrap;
        }
        .btn-create:hover {
            background: var(--accent-hover);
        }
        .btn-create:active { transform: scale(0.98); }

        /* Alert */
        .alert-error {
            background: rgba(239, 68, 68, 0.05);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 10px;
            padding: 12px 16px;
            color: #f87171;
            font-size: 0.9rem;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* ===== ROOMS GRID ===== */
        .rooms-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .room-card {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-card);
            padding: 24px;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: var(--shadow);
        }
        .room-card:hover {
            border-color: var(--border-strong);
            transform: translateY(-2px);
        }

        .room-icon {
            width: 44px; height: 44px;
            border-radius: 10px;
            background: var(--bg);
            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-bottom: 4px;
        }
        .room-name {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        .room-meta {
            color: var(--text-secondary);
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        .member-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #10B981;
        }

        /* Room action buttons */
        .btn-enter-chat {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--accent);
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 10px 18px;
            border-radius: var(--radius-btn);
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-enter-chat:hover { background: var(--accent-hover); }

        .btn-request-join {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: transparent;
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
            font-weight: 600;
            font-size: 0.9rem;
            padding: 10px 18px;
            border-radius: var(--radius-btn);
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-request-join:hover {
            background: var(--bg);
            border-color: var(--accent);
            color: var(--accent);
        }

        .badge-pending {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(245, 158, 11, 0.05);
            border: 1px solid rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 10px 18px;
            border-radius: var(--radius-btn);
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 64px 32px;
            border: 1px dashed var(--border-subtle);
            border-radius: var(--radius-card);
            color: var(--text-muted);
            background: var(--surface);
        }
        .empty-icon { font-size: 2.5rem; margin-bottom: 16px; opacity: 0.5; }
        .empty-state p { font-size: 1rem; }

        /* ===== ADMIN PANEL ===== */
        .admin-panel {
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-card);
            padding: 24px;
            position: sticky;
            top: 96px;
            box-shadow: var(--shadow);
        }
        .admin-panel-title {
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-subtle);
            color: var(--text-primary);
        }
        .admin-panel-title .shield {
            width: 32px; height: 32px;
            border-radius: 8px;
            background: var(--bg);
            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .admin-room-group { margin-bottom: 24px; }
        .admin-room-group:last-child { margin-bottom: 0; }
        .admin-room-name {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--accent);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .pending-badge {
            background: rgba(59, 130, 246, 0.1);
            color: var(--accent);
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 99px;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .request-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg);
            border: 1px solid var(--border-subtle);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 10px;
            transition: border-color 0.2s;
        }
        .request-item:hover { border-color: var(--border-strong); }
        .request-user {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .request-avatar {
            width: 28px; height: 28px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        .request-username { font-size: 0.85rem; font-weight: 500; color: var(--text-primary); }
        .request-actions { display: flex; gap: 8px; }
        .btn-approve, .btn-reject {
            width: 32px; height: 32px;
            border-radius: 8px;
            border: 1px solid var(--border-subtle);
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            background: var(--surface);
        }
        .btn-approve { color: #10B981; }
        .btn-approve:hover { background: rgba(16, 185, 129, 0.1); border-color: #10B981; }
        .btn-reject { color: #ef4444; }
        .btn-reject:hover { background: rgba(239, 68, 68, 0.1); border-color: #ef4444; }

        .no-requests {
            text-align: center;
            padding: 32px 0;
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        .no-requests i { font-size: 2rem; display: block; margin-bottom: 12px; opacity: 0.3; }

        @keyframes slide-in {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: slide-in 0.2s ease-out forwards; }
    </style>
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <a class="navbar-brand" href="/lobby">
            <img src="/img/icon.png" alt="EchoChat">
            <span class="navbar-brand-text">EchoChat</span>
        </a>
        <div class="navbar-right">
            <div class="user-badge">
                <div class="user-avatar"><%= username.charAt(0).toUpperCase() %></div>
                <span class="user-name"><%= username %></span>
            </div>
            <a href="/logout" class="btn-logout">
                <i class="fas fa-sign-out-alt"></i>
                <span class="hidden-mobile">Logout</span>
            </a>
        </div>
    </nav>

    <!-- HERO STRIP -->
    <div class="hero-strip">
        <div class="hero-strip-content">
            <h1>🏠 Chat Lobby</h1>
            <p>Browse rooms, join conversations, or create your own space</p>
            <div class="hero-stats">
                <div class="stat">
                    <span class="stat-val"><%= rooms.length %></span>
                    <span class="stat-label">Rooms</span>
                </div>
                <div class="stat">
                    <span class="stat-val"><%= rooms.reduce((a,r) => a + r.members.length, 0) %></span>
                    <span class="stat-label">Members</span>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN LAYOUT -->
    <div class="main-layout">

        <!-- LEFT: Rooms -->
        <div>
            <div class="section-header">
                <div class="section-title">
                    <i class="fas fa-door-open"></i> Available Rooms
                </div>
                <form action="/rooms/create" method="POST" class="create-room-form">
                    <input type="text" name="name" id="new-room-name" placeholder="New room name..." required>
                    <button type="submit" class="btn-create" id="create-room-btn">
                        <i class="fas fa-plus"></i> Create
                    </button>
                </form>
            </div>

            <% if (query && query.error) { %>
            <div class="alert-error">
                <i class="fas fa-exclamation-triangle"></i>
                <%= query.error %>
            </div>
            <% } %>

            <div class="rooms-grid" id="roomsGrid">
                <% rooms.forEach(room => { %>
                <div class="room-card" id="room-card-<%= room._id %>">
                    <div class="room-icon">💬</div>
                    <div class="room-name"># <%= room.name %></div>
                    <div class="room-meta">
                        <i class="fas fa-crown" style="color:#FFD60A;"></i>
                        <%= room.admin.username %>
                        &nbsp;•&nbsp;
                        <span class="member-dot"></span>
                        <%= room.members.length %> member<%= room.members.length !== 1 ? 's' : '' %>
                    </div>
                    <div id="room-action-<%= room._id %>">
                        <% if (room.isMember) { %>
                        <a href="/rooms/<%= room._id %>/chat" class="btn-enter-chat" id="enter-<%= room._id %>">
                            <i class="fas fa-arrow-right"></i> Enter Chat
                        </a>
                        <% } else if (room.isPending) { %>
                        <span class="badge-pending">
                            <i class="fas fa-clock"></i> Pending Approval
                        </span>
                        <% } else { %>
                        <button onclick="requestJoinSocket('<%= room._id %>')" class="btn-request-join" id="join-btn-<%= room._id %>">
                            <i class="fas fa-hand-paper"></i> Request Join
                        </button>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>

            <% if (rooms.length === 0) { %>
            <div class="empty-state">
                <div class="empty-icon">🌌</div>
                <p>No rooms yet — be the first to create one!</p>
            </div>
            <% } %>
        </div>

        <!-- RIGHT: Admin Panel -->
        <div>
            <div class="admin-panel">
                <div class="admin-panel-title">
                    <div class="shield">🛡️</div>
                    Admin Panel
                </div>
                <div id="adminPanelContent">
                    <% let hasRequests = false; %>
                    <% rooms.forEach(room => { %>
                        <% if (room.isAdmin && room.joinRequests.length > 0) { %>
                            <% hasRequests = true; %>
                            <div class="admin-room-group animate-in" id="admin-room-<%= room._id %>">
                                <div class="admin-room-name">
                                    <span># <%= room.name %></span>
                                    <span class="pending-badge" id="count-<%= room._id %>"><%= room.joinRequests.length %> pending</span>
                                </div>
                                <ul style="list-style:none;" id="req-list-<%= room._id %>">
                                    <% room.joinRequests.forEach(req => { %>
                                    <li class="request-item" id="request-<%= room._id %>-<%= req._id %>">
                                        <div class="request-user">
                                            <div class="request-avatar"><%= req.username.charAt(0).toUpperCase() %></div>
                                            <span class="request-username"><%= req.username %></span>
                                        </div>
                                        <div class="request-actions">
                                            <button onclick="approveRequestSocket('<%= room._id %>', '<%= req._id %>')" class="btn-approve" title="Approve">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button onclick="rejectRequestSocket('<%= room._id %>', '<%= req._id %>')" class="btn-reject" title="Reject">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </li>
                                    <% }) %>
                                </ul>
                            </div>
                        <% } %>
                    <% }) %>
                    <% if (!hasRequests) { %>
                    <div id="noRequestsMsg" class="no-requests">
                        <i class="fas fa-inbox"></i>
                        No pending join requests
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const userId = "<%= userId %>";
        const username = "<%= username %>";

        socket.emit('register-user-status', userId);

        function requestJoinSocket(roomId) {
            socket.emit('join-room-request', { roomId, userId, username });
        }

        function approveRequestSocket(roomId, requestUserId) {
            socket.emit('approve-join-request', { roomId, requestUserId });
        }

        function rejectRequestSocket(roomId, requestUserId) {
            socket.emit('reject-join-request', { roomId, requestUserId });
        }

        socket.on('join-request-sent', ({ roomId }) => {
            const container = document.getElementById(`room-action-${roomId}`);
            if (container) {
                container.innerHTML = `<span class="badge-pending"><i class="fas fa-clock"></i> Pending Approval</span>`;
            }
        });

        socket.on('join-request-received', ({ roomId, roomName, user }) => {
            let adminRoom = document.getElementById(`admin-room-${roomId}`);
            const noRequestsMsg = document.getElementById('noRequestsMsg');
            if (noRequestsMsg) noRequestsMsg.style.display = 'none';

            if (!adminRoom) {
                const adminPanelContent = document.getElementById('adminPanelContent');
                const roomDiv = document.createElement('div');
                roomDiv.id = `admin-room-${roomId}`;
                roomDiv.className = 'admin-room-group animate-in';
                roomDiv.innerHTML = `
                    <div class="admin-room-name">
                        <span># ${roomName}</span>
                        <span class="pending-badge" id="count-${roomId}">1 pending</span>
                    </div>
                    <ul style="list-style:none;" id="req-list-${roomId}"></ul>
                `;
                adminPanelContent.appendChild(roomDiv);
                adminRoom = roomDiv;
            }

            const list = document.getElementById(`req-list-${roomId}`) || adminRoom.querySelector('ul');
            if (!document.getElementById(`request-${roomId}-${user._id}`)) {
                const li = document.createElement('li');
                li.id = `request-${roomId}-${user._id}`;
                li.className = 'request-item animate-in';
                li.innerHTML = `
                    <div class="request-user">
                        <div class="request-avatar">${user.username.charAt(0).toUpperCase()}</div>
                        <span class="request-username">${user.username}</span>
                    </div>
                    <div class="request-actions">
                        <button onclick="approveRequestSocket('${roomId}', '${user._id}')" class="btn-approve" title="Approve"><i class="fas fa-check"></i></button>
                        <button onclick="rejectRequestSocket('${roomId}', '${user._id}')" class="btn-reject" title="Reject"><i class="fas fa-times"></i></button>
                    </div>
                `;
                list.appendChild(li);
            }
        });

        socket.on('join-approved', ({ roomId }) => {
            window.location.href = `/rooms/${roomId}/chat`;
        });

        socket.on('approval-success', ({ roomId, requestUserId }) => {
            removeRequestFromUI(roomId, requestUserId);
        });

        socket.on('rejection-success', ({ roomId, requestUserId }) => {
            removeRequestFromUI(roomId, requestUserId);
        });

        function removeRequestFromUI(roomId, requestUserId) {
            const reqEl = document.getElementById(`request-${roomId}-${requestUserId}`);
            if (reqEl) {
                reqEl.style.opacity = '0';
                reqEl.style.transform = 'translateX(20px)';
                reqEl.style.transition = 'all 0.3s ease';
                setTimeout(() => {
                    reqEl.remove();
                    const list = document.getElementById(`req-list-${roomId}`) || document.querySelector(`#admin-room-${roomId} ul`);
                    if (list && list.children.length === 0) {
                        const roomGroup = document.getElementById(`admin-room-${roomId}`);
                        if (roomGroup) roomGroup.remove();
                        const adminPanelContent = document.getElementById('adminPanelContent');
                        if (adminPanelContent.children.length === 0) {
                            const noMsg = document.createElement('div');
                            noMsg.id = 'noRequestsMsg';
                            noMsg.className = 'no-requests';
                            noMsg.innerHTML = '<i class="fas fa-inbox"></i>No pending join requests';
                            adminPanelContent.appendChild(noMsg);
                        }
                    }
                }, 300);
            }
        }
    </script>
</body>
</html>
