<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lobby - EchoChat</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 text-gray-800">
    <nav class="bg-white p-4 shadow flex justify-between items-center">
        <h1 class="text-xl font-bold text-blue-600">EchoChat Lobby</h1>
        <div>
            <span class="mr-4">Logged in as: <strong><%= username %></strong></span>
            <a href="/logout" class="text-red-500 hover:text-red-700 font-bold">Logout</a>
        </div>
    </nav>

    <div class="container mx-auto mt-8 flex px-4 gap-8">
        <!-- Rooms Section -->
        <div class="w-2/3">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-2xl font-bold">Available Rooms</h2>
                <!-- Create Room Form -->
                <form action="/rooms/create" method="POST" class="flex gap-2">
                    <input type="text" name="name" placeholder="New Room Name" required class="border p-2 rounded">
                    <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded">Create</button>
                </form>
            </div>

            <% if (query && query.error) { %>
                <p class="text-red-500 mb-4"><%= query.error %></p>
            <% } %>

            <div class="grid grid-cols-2 gap-4">
                <% rooms.forEach(room => { %>
                    <div class="bg-white p-4 rounded shadow border">
                        <h3 class="font-bold text-lg">#<%= room.name %></h3>
                        <p class="text-sm text-gray-500 mb-2">Admin: <%= room.admin.username %> | <%= room.members.length %> members</p>
                        
                        <% if (room.isMember) { %>
                            <a href="/rooms/<%= room._id %>/chat" class="bg-blue-500 text-white px-3 py-1 rounded inline-block">Enter Chat</a>
                        <% } else if (room.isPending) { %>
                            <span class="text-yellow-600 bg-yellow-100 px-3 py-1 rounded inline-block">Pending Approval</span>
                        <% } else { %>
                            <form action="/rooms/<%= room._id %>/request" method="POST" class="inline">
                                <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded">Request Join</button>
                            </form>
                        <% } %>
                    </div>
                <% }) %>
            </div>
            <% if (rooms.length === 0) { %>
                <p class="text-gray-500">No rooms available. Create one!</p>
            <% } %>
        </div>

        <!-- Admin Requests Section -->
        <div class="w-1/3 bg-white p-6 rounded shadow h-fit">
            <h2 class="text-xl font-bold mb-4 border-b pb-2">Admin Panel</h2>
            <% let hasRequests = false; %>
            <% rooms.forEach(room => { %>
                <% if (room.isAdmin && room.joinRequests.length > 0) { %>
                    <% hasRequests = true; %>
                    <div class="mb-4">
                        <h4 class="font-bold text-blue-600">#<%= room.name %> Requests</h4>
                        <ul class="mt-2 space-y-2">
                            <% room.joinRequests.forEach(req => { %>
                                <li class="flex justify-between items-center bg-gray-50 p-2 rounded">
                                    <span><%= req.username %></span>
                                    <div class="flex gap-2">
                                        <form action="/rooms/<%= room._id %>/approve" method="POST">
                                            <input type="hidden" name="requestUserId" value="<%= req._id %>">
                                            <button type="submit" class="text-green-600 hover:text-green-800">✅</button>
                                        </form>
                                        <form action="/rooms/<%= room._id %>/reject" method="POST">
                                            <input type="hidden" name="requestUserId" value="<%= req._id %>">
                                            <button type="submit" class="text-red-600 hover:text-red-800">❌</button>
                                        </form>
                                    </div>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>
            <% }) %>
            
            <% if (!hasRequests) { %>
                <p class="text-gray-500 text-sm">No pending join requests.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
